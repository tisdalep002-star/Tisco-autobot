# MYTHOS Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Model to use (default: claude-opus-4-5)
MYTHOS_MODEL=claude-opus-4-5

# Optional: Maximum tokens per response (default: 8192)
MYTHOS_MAX_TOKENS=8192

# Optional: Command timeout in seconds (default: 30)
MYTHOS_TIMEOUT=30

# Optional: Enable debug logging
DEBUG=false
